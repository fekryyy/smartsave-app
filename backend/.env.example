# ── Server ──
PORT=5001
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ──
MONGODB_URI=mongodb://localhost:27017/smartsave

# ── Redis ──
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# ── JWT Auth ──
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_refresh_secret_change_this
JWT_REFRESH_EXPIRE=90d

# ── Frontend ──
FRONTEND_URL=http://localhost:3000

# ── Email (optional) ──
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# ── MFA / Encryption ──
# AES-256-GCM encryption key for MFA secrets and sensitive financial data at rest.
# Must be a 64-character hex string (32 bytes) or any string (will be SHA-256 derived).
MFA_ENCRYPTION_KEY=your_64_char_hex_encryption_key_change_this_in_production

# ── Google OAuth (optional) ──
# GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── AI Provider ──
# Supported providers: "openai" | "claude" | "deepseek"
AI_PROVIDER=openai
AI_API_KEY=sk-your_openai_api_key_here
AI_MODEL=gpt-4o
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=4096
# AI_MAX_RETRIES=3

# ── Claude alternative ──
# AI_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-your_claude_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── DeepSeek alternative ──
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
