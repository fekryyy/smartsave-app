PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartsave
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_refresh_secret_change_this
JWT_REFRESH_EXPIRE=90d
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
GOOGLE_CLIENT_ID=your_google_oauth_client_id
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# AI Provider Configuration
# Supported providers: "openai" | "claude" | "deepseek"
AI_PROVIDER=openai
AI_API_KEY=sk-your_openai_api_key_here
AI_MODEL=gpt-4o
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=4096
# AI_MAX_RETRIES=3

# Claude alternative (comment out OpenAI settings above and use these):
# AI_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-your_claude_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# DeepSeek alternative (comment out others and use these):
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
